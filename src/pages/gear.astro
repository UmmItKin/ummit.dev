---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { gear } from '@/config/gear'

const ogImage = { src: '/og/gear.png', alt: 'My Gear' }
---

<BaseLayout title="Gear" description="My hardware and software setup." image={ogImage}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold opacity-80">Gear</h1>
    <p class="mt-2 opacity-50">My daily hardware and software setup.</p>
  </div>

  <div class="space-y-12">
    {
      gear.map((section) => (
        <section>
          <h2 class="text-xl font-semibold mb-1 flex items-center gap-2">
            <i class:list={[section.icon, 'opacity-60']} />
            {section.title}
          </h2>
          {section.subtitle && <p class="text-sm opacity-50 mb-4">{section.subtitle}</p>}
          {!section.subtitle && <div class="mb-4" />}
          <div class="grid gap-2">
            {section.items.map((item: any) => (
              <div class="flex flex-col sm:flex-row sm:items-center py-2 border-b border-neutral-800">
                <span class="text-sm opacity-50 sm:w-40 shrink-0">{item.label}</span>
                <span class="text-sm" set:html={item.value} />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
