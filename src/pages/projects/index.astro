---
import { projectData } from '@/config/projects'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListProjects from '@/components/ListProjects.astro'
import Sponsor from '@/components/Sponsor.astro'
---

<BaseLayout title="Projects" description="List of projects that I am proud of">
  <h1 class="mb-10 text-title">Projects</h1>

  <section class="mt-8">
    <p class="mb-6 opacity-90">
      Here are some of the projects that I have worked on and am proud of. These projects showcase my skills and
      experience in various technologies and domains.
    </p>

    <Sponsor />
  </section>

  <div mb-16 sm:mb-24>
    {
      projectData.length > 0 && (
        <div>
          {projectData.map((i) => (
            <div mb-10>
              <h2 class="select-none relative h20 pointer-events-none">
                <span class="text-3.2em color-transparent font-bold text-stroke-1.5 text-stroke-hex-aaa op20 absolute top-0">
                  {i.title}
                </span>
              </h2>
              <ListProjects list={i.projects} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
