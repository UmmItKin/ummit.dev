---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListPosts from '@/components/ListPosts.astro'
import { getPosts } from '@/utils/posts'
import { getWriterLevel } from '@/utils/level'

const ogImage = { src: '/og/paper.png', alt: 'Papers' }
const posts = await getPosts(undefined, 'paper')
const levelInfo = getWriterLevel(posts.length)

// Get the earliest year from posts
const earliestYear =
  posts.length > 0 ? Math.min(...posts.map((post) => new Date(post.data.date).getFullYear())) : new Date().getFullYear()
---

<BaseLayout title="Papers" description="Technical papers and in-depth analyses." image={ogImage}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold opacity-80">Papers</h1>
    <p class="mt-2 opacity-50">Technical papers and in-depth security analyses.</p>
  </div>

  <div class="mb-8 p-4 rounded-lg bg-neutral-800/30 border border-neutral-700/50">
    <div class="flex items-center gap-2 mb-1 flex-wrap">
      <span class="font-semibold text-base">
        {levelInfo.count}
        {levelInfo.count === 1 ? 'paper' : 'papers'} published
      </span>
      <span class="text-base opacity-60">·</span>
      <span class="text-base font-medium text-purple-400">{levelInfo.level}</span>
      <span class="text-base opacity-60">·</span>
      <span class="text-base opacity-50">Since {earliestYear}</span>
    </div>
    <p class="text-sm opacity-70 italic">{levelInfo.message}</p>
  </div>

  <ListPosts list={posts} />
</BaseLayout>
