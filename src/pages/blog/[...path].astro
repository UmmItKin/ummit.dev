---
import PostListPage from '@/components/PostListPage.astro'
import { siteConfig } from '@/config'
import { getPosts } from '@/utils/posts'

export async function getStaticPaths() {
  return siteConfig.page.blogLinks.map((nav) => {
    const href = nav.href.replace('/blog', '')
    return { params: { path: href === '' ? undefined : href.replace(/^\/+|\/+$/g, '') } }
  })
}

const { path } = Astro.params
const posts = await getPosts(path)

const ogImage = {
  src: `/og/${path ? path : 'blog'}.png`,
  alt: path ? path.charAt(0).toUpperCase() + path.slice(1) : 'Blog',
}
---

<PostListPage
  title="Blog"
  description="List of all the blog posts."
  ogImage={ogImage}
  posts={posts}
  noun={['article', 'articles']}
  verb="written"
  color="text-blue-400"
/>
