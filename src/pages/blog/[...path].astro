---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListPosts from '@/components/ListPosts.astro'
import siteConfig from '@/site-config'
import { getPosts } from '@/utils/posts'
import { getWriterLevel } from '@/utils/level'

export async function getStaticPaths() {
  const paths = siteConfig.page.blogLinks.map((nav) => {
    const href = nav.href.replace('/blog', '')
    return {
      params: {
        path: href === '' ? undefined : href.replace(/^\/+|\/+$/g, ''),
      },
    }
  })
  return paths
}

const { path } = Astro.params

const posts = await getPosts(path)
const levelInfo = getWriterLevel(posts.length)

// Get the earliest year from posts
const earliestYear =
  posts.length > 0 ? Math.min(...posts.map((post) => new Date(post.data.date).getFullYear())) : new Date().getFullYear()

// Set OG image based on current path
const ogImage = {
  src: `/og/${path ? path : 'blog'}.png`,
  alt: path ? path.charAt(0).toUpperCase() + path.slice(1) : 'Blog',
}

function activeLink(pathname: string) {
  return Astro.url.pathname.replace(/\/+/g, '/').replace(/\/$/, '') === pathname
}
---

<BaseLayout title="Blog" description="List of all the blog posts." image={ogImage}>
  <div class="flex flex-col gap-2 sm:flex-row sm:gap-4 flex-wrap mb-4">
    {
      siteConfig.page.blogLinks.map((nav) => (
        <a
          aria-label={nav.text}
          class={`nav-link text-3xl font-bold ${activeLink(nav.href) ? 'opacity-80' : 'opacity-30 hover:opacity-50'}`}
          href={nav.href}
        >
          {nav.text}
        </a>
      ))
    }
  </div>

  <div class="mb-8 p-4 rounded-lg bg-neutral-800/30 border border-neutral-700/50">
    <div class="flex items-center gap-x-3 mb-1">
      <span class="text-base font-semibold">
        {levelInfo.count}
        {levelInfo.count === 1 ? 'article' : 'articles'} written
      </span>
      <span class="text-base opacity-50">·</span>
      <span class="text-base font-medium text-blue-400">{levelInfo.level}</span>
      <span class="text-base opacity-50">·</span>
      <span class="text-base opacity-50">Since {earliestYear}</span>
    </div>
    <p class="text-sm opacity-70 italic">{levelInfo.message}</p>
  </div>

  <ListPosts list={posts} />
</BaseLayout>
