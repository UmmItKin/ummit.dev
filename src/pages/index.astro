---
import BaseLayout from '@/layouts/BaseLayout.astro'
import GitHubGraph from '@/components/GitHubGraph.vue'
import SkillRadar from '@/components/SkillRadar.vue'
import HoverPreviewLink from '@/components/HoverPreviewLink.astro'
import Sponsor from '@/components/Sponsor.astro'
import { siteConfig } from '@/config'
import { profile } from '@/config/profile'
import { skills } from '@/config/skills'
import { stacks } from '@/config/stacks'
import { timeline } from '@/config/timeline'
import { competitions } from '@/config/competitions'
import { features } from '@/config/features'
import { fetchGitHubContributions } from '@/utils/github-contributions'

const ogImage = { src: '/og/index.png', alt: siteConfig.title }

const contributions = features.githubContributions ? await fetchGitHubContributions(siteConfig.github) : null

const badgeGroups = [
  { label: 'CTF Team', badges: profile.badges.teams ?? [] },
  { label: 'Challenge Creator', badges: profile.badges.challenges ?? [] },
  { label: 'Hacking', badges: profile.badges.platforms ?? [] },
  { label: 'Creator', badges: profile.badges.projects ?? [] },
  { label: 'Community', badges: profile.badges.community ?? [] },
  { label: 'Candidate', badges: profile.badges.certifications ?? [] },
].filter((g) => g.badges.length > 0)
---

<BaseLayout description={siteConfig.description} image={ogImage}>
  <article class="prose">
    <h1 class="text-title flex items-center gap-2">
      {profile.name}
      {profile.taglineIcon && <i class:list={[profile.taglineIcon, 'text-3xl']} />}
    </h1>
    <p>{profile.intro}</p>
    {profile.subtagline && <p class="mt-1 text-sm opacity-60">{profile.subtagline}</p>}

    {
      badgeGroups.length > 0 && (
        <p class="ctf-section">
          {badgeGroups.map((group, gi) => (
            <>
              {gi > 0 && <br />}
              <span>{group.label} </span>
              {group.badges.map((badge: any) => (
                <HoverPreviewLink
                  href={badge.href}
                  title={badge.title}
                  subtitle={badge.subtitle}
                  description={badge.description}
                >
                  <span class="magic-link-icon">
                    {badge.image ? (
                      <img src={badge.image} alt="" width="500" height="500" />
                    ) : (
                      <i class:list={[badge.icon]} style={badge.color ? `color: ${badge.color}` : ''} />
                    )}
                  </span>
                  {badge.title}
                </HoverPreviewLink>
              ))}
            </>
          ))}
        </p>
      )
    }

    {profile.bio.map((p: string) => <p>{p}</p>)}

    <hr class="hr-line" />

    <p class="flex items-center gap-x-4 gap-y-2 flex-wrap">
      {
        siteConfig.socialLinks.map((link) => (
          <a aria-label={link.text} href={link.href} target="_blank" class="prose-link">
            <i class:list={[link.icon]} /> {link.text}
          </a>
        ))
      }
    </p>

    <div class="flex flex-col sm:flex-row gap-2 sm:gap-6 mt-4 text-sm opacity-80">
      <a class="prose-link flex items-center gap-1" href={`mailto:${siteConfig.email}`}>
        <i class="i-ri-mail-line"></i>
        {siteConfig.email}
        <span class="opacity-70">(casual)</span>
      </a>
      <a class="prose-link flex items-center gap-1" href={`mailto:${siteConfig.email_two}`}>
        <i class="i-ri-briefcase-line"></i>
        {siteConfig.email_two}
        <span class="opacity-70">(job)</span>
      </a>
    </div>

    {
      profile.gpgKeyUrl && (
        <a
          class="prose-link inline-flex items-center gap-1 mt-3 text-xs opacity-40 whitespace-nowrap"
          href={profile.gpgKeyUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="i-ri-key-2-line" />
          GPG Key
        </a>
      )
    }

    <hr class="hr-line" />

    {
      features.sponsor && (
        <>
          <section class="mt-8">
            <h2 class="text-sm font-medium mb-4 flex items-center gap-2 opacity-80">
              <i class="i-ri-cup-line" />
              Sponsor
            </h2>
            <Sponsor />
          </section>
          <hr class="hr-line" />
        </>
      )
    }

    {
      contributions && (
        <>
          <section class="mt-8">
            <h2 class="text-sm font-medium mb-4 flex items-center gap-2 opacity-80">
              <i class="i-simple-icons-git" />
              Contributions
            </h2>
            <GitHubGraph client:visible days={contributions.days} total={contributions.total} />
          </section>
          <hr class="hr-line" />
        </>
      )
    }

    {
      features.skills && (
        <>
          <section class="mt-8">
            <h2 class="text-sm font-medium mb-4 flex items-center gap-2 opacity-80">
              <i class="i-ri-trophy-line" />
              Skills
            </h2>
            <p class="text-sm opacity-70 mb-4">This is my skill :D</p>
            <SkillRadar client:idle data={skills} />
          </section>
          <hr class="hr-line" />
        </>
      )
    }

    {
      features.timeline && (
        <>
          <section class="mt-8">
            <h2 class="text-xl font-semibold mb-6">Timeline</h2>
            <div class="relative border-l-2 border-neutral-700 pl-6 space-y-8">
              {timeline.map((entry) => (
                <div class="relative">
                  <div class="absolute -left-8 top-0 w-4 h-4 rounded-full bg-neutral-400 flex items-center justify-center">
                    <i class:list={[entry.icon, 'text-black text-xs']} />
                  </div>
                  <h3 class="font-medium mt-0">
                    {entry.title}
                    {entry.url && (
                      <a
                        href={entry.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Visit ${entry.title} website`}
                        class="timeline-link"
                      >
                        <i class="i-ri-external-link-line text-sm" />
                      </a>
                    )}
                  </h3>
                  <p class="text-sm opacity-70">{entry.date}</p>
                  <p class="text-sm mt-2 opacity-80">{entry.role}</p>
                </div>
              ))}
            </div>
          </section>
          <hr class="hr-line" />
        </>
      )
    }

    {
      features.competitions && (
        <>
          <section class="mt-8">
            <h2 class="text-sm font-medium mb-4 flex items-center gap-2 opacity-80">
              <i class="i-ri-trophy-line" />
              Competition Experience
            </h2>
            <p class="text-xs opacity-45 -mt-3 mb-4">
              Only the best runs are listed — I play other CTFs casually too, just not at full effort.
            </p>

            <div class="md:hidden divide-y divide-neutral-800">
              {competitions.map((c) => (
                <div class="py-3">
                  <h3 class="font-medium mt-0">{c.name}</h3>
                  <div class="text-sm opacity-70">
                    {c.date} · {c.team}
                    {c.division && c.division !== '\u2014' ? ` · ${c.division}` : ''}
                  </div>
                  <div class="text-sm mt-1">
                    <strong>{c.placement}</strong>
                    {c.details && c.details !== '\u2014' ? ` · ${c.details}` : ''}
                  </div>
                  {c.subDetails && <div class="text-xs opacity-45 mt-1">{c.subDetails}</div>}
                </div>
              ))}
            </div>

            <div class="hidden md:block overflow-x-auto">
              <table class="competition-table w-full text-sm text-left">
                <thead>
                  <tr class="border-b border-neutral-700">
                    <th class="pb-2 pr-3 font-medium opacity-70">Competition</th>
                    <th class="pb-2 pr-3 font-medium opacity-70 whitespace-nowrap">Date</th>
                    <th class="pb-2 pr-3 font-medium opacity-70">Team</th>
                    <th class="pb-2 pr-3 font-medium opacity-70">Division</th>
                    <th class="pb-2 pr-3 font-medium opacity-70 whitespace-nowrap">Placement</th>
                    <th class="pb-2 font-medium opacity-70 whitespace-nowrap">Pts / Solves</th>
                  </tr>
                </thead>
                <tbody>
                  {competitions.map((c) => (
                    <tr class="border-b border-neutral-800">
                      <td class="py-2 pr-3 font-medium align-top">{c.name}</td>
                      <td class="py-2 pr-3 opacity-70 whitespace-nowrap align-top">{c.date}</td>
                      <td class="py-2 pr-3 align-top">
                        {c.teamIcon && (
                          <span class="magic-link-icon inline-block w-4 h-4 mr-1 align-text-bottom">
                            <img src={c.teamIcon} alt="" width="40" height="40" />
                          </span>
                        )}
                        {c.team}
                      </td>
                      <td class="py-2 pr-3 opacity-70 align-top">{c.division || '\u2014'}</td>
                      <td class="py-2 pr-3 whitespace-nowrap align-top">
                        <strong>{c.placement}</strong>
                      </td>
                      <td class="py-2 whitespace-nowrap align-top">
                        {c.details || '\u2014'}
                        {c.subDetails && <div class="text-xs opacity-45 mt-1">{c.subDetails}</div>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
          <hr class="hr-line" />
        </>
      )
    }

    {
      features.stacks && (
        <section class="mt-8">
          <h2 class="text-sm font-medium mb-4 flex items-center gap-2 opacity-80">
            <i class="i-ri-flashlight-line" />
            Stacks
          </h2>

          <div class="stack-desc bg-neutral-800 rounded-lg px-4 py-3 mb-4 flex flex-col gap-1">
            <span class="font-semibold text-base text-main flex items-center gap-2">
              The Stacks for my development, hacking, and daily use.
            </span>
            <small class="text-xs text-main/60 italic mt-1"> Cannot list all here, just the main ones :) </small>
          </div>

          {stacks.map((row, i) => (
            <div class:list={['marquee-container', i > 0 && 'mt-4']}>
              <div class:list={['marquee-track', i % 2 === 0 ? 'animate-marquee' : 'animate-marquee-reverse']}>
                <div class="marquee-content">
                  {row.map((icon) => (
                    <i class:list={[icon, 'text-4xl opacity-60']} />
                  ))}
                </div>
                <div class="marquee-content" aria-hidden="true">
                  {row.map((icon) => (
                    <i class:list={[icon, 'text-4xl opacity-60']} />
                  ))}
                </div>
              </div>
            </div>
          ))}
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .marquee-container {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-content {
    display: flex;
    gap: 3rem;
    padding-right: 3rem;
    flex-shrink: 0;
  }

  .animate-marquee {
    animation: marquee 40s linear infinite;
  }

  .animate-marquee-reverse {
    animation: marquee-reverse 40s linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes marquee-reverse {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  .magic-link-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.125rem;
  }

  .magic-link-icon i {
    font-size: 1em;
    opacity: 0.8;
  }

  .timeline-link {
    margin-left: 0.5rem;
    opacity: 0.5;
    transition: opacity 0.2s ease;
    border: none !important;
  }

  .timeline-link:hover {
    opacity: 1;
    border: none !important;
  }

  .competition-table tbody tr {
    transition: background 0.2s ease;
  }

  .competition-table tbody tr:hover {
    background: rgba(136, 136, 136, 0.06);
  }
</style>
