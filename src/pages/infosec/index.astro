---
import PostListPage from '@/components/PostListPage.astro'
import { getPosts } from '@/utils/posts'

const posts = await getPosts(undefined, 'infosec')
---

<PostListPage
  title="InfoSec"
  description="List of all InfoSec articles."
  ogImage={{ src: '/og/infosec.png', alt: 'InfoSec Articles' }}
  posts={posts}
  noun={['article', 'articles']}
  verb="written"
  color="text-purple-400"
/>
