---
import PostListPage from '@/components/PostListPage.astro'
import { getPosts } from '@/utils/posts'

const posts = await getPosts(undefined, 'research')
---

<PostListPage
  title="Security Research"
  description="Zero-day discoveries and CVE research."
  ogImage={{ src: '/og/research.png', alt: 'Security Research' }}
  posts={posts}
  noun={['research', 'researches']}
  verb="published"
  color="text-red-400"
/>
