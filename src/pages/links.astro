---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import avatarImg from '@/assets/links.webp'

const ogImage = { src: '/og/links.png', alt: 'Links' }

const links = [
  {
    text: 'AUR',
    href: 'https://aur.archlinux.org/account/UmmItKin',
    icon: 'i-simple-icons-archlinux',
  },
  {
    text: 'GitHub',
    href: 'https://github.com/UmmItKin',
    icon: 'i-simple-icons-github',
  },
  {
    text: 'Buy me a Coffee',
    href: 'https://buymeacoffee.com/ummit',
    icon: 'i-simple-icons-buymeacoffee',
  },
  {
    text: 'Blog',
    href: '/blog',
    icon: 'i-ri-rss-line',
  },
  {
    text: 'Passthru',
    href: 'https://gpu.passthru.info',
    icon: 'i-ri-book-2-line',
  },
  {
    text: 'Status',
    href: 'https://status.ummit.dev',
    icon: 'i-ri-signal-tower-line',
  },
]
---

<BaseLayout title="Links" description="All my links in one place." image={ogImage}>
  <div class="flex flex-col items-center justify-center min-h-70vh py-12">
    <!-- Avatar -->
    <div class="mb-5">
      <Image
        src={avatarImg}
        alt="UmmIt Kin"
        width={500}
        height={500}
        class="avatar-blur w-28 h-28 md:w-32 md:h-32 rounded-full border-2 border-neutral-500/25 transition-all duration-300"
        loading="eager"
      />
    </div>

    <!-- Name -->
    <h1 class="text-2xl font-bold">UmmIt Kin</h1>
    <p class="text-sm opacity-45 mt-1 mb-8">HKer · InfoSec · GNU/Linux</p>

    <!-- Links -->
    <div class="flex flex-col gap-3 w-full max-w-md px-4">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            target={link.href.startsWith('/') ? '_self' : '_blank'}
            rel={link.href.startsWith('/') ? '' : 'noopener noreferrer'}
            class="link-btn flex items-center justify-center gap-3 py-3 px-6 rounded-xl border border-neutral-700/80 bg-neutral-800/40 hover:bg-neutral-700/40 hover:border-neutral-500/60 hover:-translate-y-0.5 transition-all duration-200 decoration-none"
            style={`animation-delay: ${i * 60}ms`}
          >
            <i class:list={[link.icon, 'text-lg opacity-80']} />
            <span class="font-medium">{link.text}</span>
          </a>
        ))
      }
    </div>

    <!-- Footer -->
    <p class="mt-10 text-xs opacity-25">ummit.dev</p>
  </div>
</BaseLayout>

<style>
  .avatar-blur {
    filter: blur(10px);
    transform: scale(1.05);
  }

  .avatar-blur.loaded {
    filter: blur(0);
    transform: scale(1);
  }

  .link-btn {
    animation: linkFadeIn 0.4s ease-out both;
  }

  @keyframes linkFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initBlurLoad() {
    const img = document.querySelector('.avatar-blur')
    if (!(img instanceof HTMLImageElement)) {
      return
    }
    const handleLoad = () => img.classList.add('loaded')
    img.complete ? handleLoad() : img.addEventListener('load', handleLoad, { once: true })
  }

  initBlurLoad()
  document.addEventListener('astro:page-load', initBlurLoad)
</script>
