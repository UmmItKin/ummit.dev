---
import PostListPage from '@/components/PostListPage.astro'
import { getPosts } from '@/utils/posts'

const posts = await getPosts(undefined, 'musings')
---

<PostListPage
  title="Musings"
  description="Personal notes and reflections."
  ogImage={{ src: '/og/musings.png', alt: 'Musings' }}
  posts={posts}
  noun={['piece', 'pieces']}
  verb="written"
  color="text-purple-400"
/>
