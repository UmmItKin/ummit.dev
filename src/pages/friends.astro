---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'

import lemonteaImg from '@/assets/friends/lemontea.png'
import chilinImg from '@/assets/friends/chilin.png'
import frankImg from '@/assets/friends/frank.png'
import elliotImg from '@/assets/friends/elliot.png'
import yochanImg from '@/assets/friends/yochan.png'
import kohiroImg from '@/assets/friends/kohiro.png'
import robinImg from '@/assets/friends/robin.png'
import auronImg from '@/assets/friends/auron.webp'
import syuanImg from '@/assets/friends/syuan.png'
import shirakamiNekoImg from '@/assets/friends/shirakami-neko.png'
import wolfYuanImg from '@/assets/friends/wolf-yuan.png'

const ogImage = { src: '/og/friends.png', alt: 'Friends' }

const friendsList = [
  {
    image: lemonteaImg,
    name: 'LemonTea',
    url: 'https://blog-lemontea.pages.dev/',
    github: 'https://github.com/LemonTeatw1',
    tooltip: '',
  },
  {
    image: chilinImg,
    name: 'ChiLin.H',
    url: 'https://neko70.net/',
    github: 'https://github.com/qilin102223',
    tooltip: '',
  },
  {
    image: frankImg,
    name: 'Frank',
    url: 'https://frk.tw/',
    github: 'https://github.com/Frank-Kam',
    tooltip: '',
  },
  {
    image: elliotImg,
    name: 'Elliot',
    url: 'https://elliot-tw.me/',
    github: 'https://github.com/Elliot-32',
    tooltip: '',
  },
  {
    image: yochanImg,
    name: 'Yochan',
    url: 'https://yochan06.github.io/',
    github: 'https://github.com/yochan06',
    tooltip: '',
  },
  {
    image: kohiroImg,
    name: 'Kohiro',
    url: 'https://github.com/kohiro961021',
    github: 'https://github.com/kohiro961021',
    tooltip: '',
  },
  {
    image: robinImg,
    name: 'Robin',
    url: 'https://robin-tw.me/',
    github: 'https://github.com/cxk228922',
    tooltip: '',
  },
  {
    image: auronImg,
    name: 'Auron',
    url: 'https://4ur0n.github.io/',
    github: 'https://github.com/4ur0n',
  },
  {
    image: syuanImg,
    name: 'Syuan',
    url: 'https://5yu4n.github.io/',
    github: 'https://github.com/5yu4n',
    tooltip: '',
  },
  {
    image: shirakamiNekoImg,
    name: '白上ねこ',
    url: 'https://moe.lolicon.io',
    github: 'https://github.com/shirakamiNeko',
    tooltip: '香香軟軟糯糯可口的芋泥鮮奶🥛',
  },
  {
    image: wolfYuanImg,
    name: 'Wolf Yuan',
    url: 'https://wolf-yuan.dev/',
    github: 'https://github.com/wolf-yuan-6115',
    tooltip: '',
  },
]
---

<BaseLayout title="Friends" description="My friends and their awesome websites." image={ogImage}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold opacity-80">Friends</h1>
    <p class="text-sm opacity-45 mt-2">People I know and respect — check out their stuff.</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    {
      friendsList.map((friend) => (
        <div class="friend-card flex flex-col items-center p-4 rounded-xl border border-neutral-800 hover:border-neutral-600 hover:bg-neutral-500/5 transition-all duration-300 group">
          <a href={friend.url} target="_blank" rel="noopener noreferrer" class="relative">
            <Image
              src={friend.image}
              alt={`${friend.name}'s avatar`}
              width={700}
              height={700}
              class="friend-avatar w-20 h-20 rd-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </a>
          <a
            href={friend.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 text-sm font-medium opacity-85 hover:opacity-100 transition-opacity decoration-none"
          >
            {friend.name}
          </a>
          {friend.tooltip && <span class="mt-1 text-xs opacity-40 text-center leading-snug">{friend.tooltip}</span>}
          <div class="mt-2 flex gap-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <a
              href={friend.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs opacity-45 hover:opacity-100 transition-opacity decoration-none"
            >
              <i class="i-simple-icons-github text-xs" /> GH
            </a>
            <a
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs opacity-45 hover:opacity-100 transition-opacity decoration-none"
            >
              <i class="i-ri-global-line text-xs" /> Web
            </a>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .friend-avatar {
    filter: blur(10px);
    transform: scale(1.05);
  }

  .friend-avatar.loaded {
    filter: blur(0);
    transform: scale(1);
  }
</style>

<script>
  function initBlurLoad() {
    document.querySelectorAll('.friend-avatar').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) {
        return
      }
      const handleLoad = () => img.classList.add('loaded')
      img.complete ? handleLoad() : img.addEventListener('load', handleLoad, { once: true })
    })
  }

  initBlurLoad()
  document.addEventListener('astro:page-load', initBlurLoad)
</script>
