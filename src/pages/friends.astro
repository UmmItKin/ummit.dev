---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { friends } from '@/config/friends'

const ogImage = { src: '/og/friends.png', alt: 'Friends' }
---

<BaseLayout title="Friends" description="My friends and their awesome websites." image={ogImage}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold opacity-80">Friends</h1>
    <p class="text-sm opacity-45 mt-2">Cool people and their corners of the internet.</p>
  </div>

  <ul class="flex flex-col divide-y divide-neutral-800/70">
    {
      friends.map((friend) => (
        <li class="friend-row flex items-center gap-5 md:gap-6 py-5 md:py-6">
          <a href={friend.url} target="_blank" rel="noopener noreferrer" class="shrink-0">
            <img
              src={friend.image}
              alt={`${friend.name}'s avatar`}
              width="80"
              height="80"
              class="friend-avatar w-16 h-16 md:w-20 md:h-20 rd-full object-cover"
              loading="lazy"
            />
          </a>

          <div class="min-w-0">
            <a
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg md:text-xl font-medium opacity-90 hover:opacity-100 transition-opacity decoration-none"
            >
              {friend.name}
            </a>
            {friend.tooltip && <p class="text-sm opacity-40 mt-1 leading-snug truncate">{friend.tooltip}</p>}

            <div class="flex items-center gap-4 mt-2">
              <a
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${friend.name}'s website`}
                class="inline-flex opacity-40 hover:opacity-100 transition-opacity duration-200 decoration-none"
              >
                <i class="i-ri-global-line text-lg" />
              </a>
              <a
                href={friend.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${friend.name}'s GitHub`}
                class="inline-flex opacity-40 hover:opacity-100 transition-opacity duration-200 decoration-none"
              >
                <i class="i-simple-icons-github text-base" />
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .friend-avatar {
    filter: blur(10px);
    transform: scale(1.05);
  }

  .friend-avatar.loaded {
    filter: blur(0);
    transform: scale(1);
  }
</style>

<script>
  function initBlurLoad() {
    document.querySelectorAll('.friend-avatar').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) {
        return
      }
      const handleLoad = () => img.classList.add('loaded')
      img.complete ? handleLoad() : img.addEventListener('load', handleLoad, { once: true })
    })
  }

  initBlurLoad()
  document.addEventListener('astro:page-load', initBlurLoad)
</script>
