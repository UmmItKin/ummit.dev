---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { friends } from '@/config/friends'

const ogImage = { src: '/og/friends.png', alt: 'Friends' }
---

<BaseLayout title="Friends" description="My friends and their awesome websites." image={ogImage}>
  <div class="mb-8">
    <h1 class="text-3xl font-bold opacity-80">Friends</h1>
    <p class="text-sm opacity-45 mt-2">Cool people and their corners of the internet.</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
    {
      friends.map((friend) => (
        <div class="friend-card flex flex-col items-center p-3 md:p-4 rounded-xl border border-neutral-800 hover:border-neutral-600 hover:bg-neutral-500/5 transition-all duration-300 group">
          <a href={friend.url} target="_blank" rel="noopener noreferrer" class="relative">
            <img
              src={friend.image}
              alt={`${friend.name}'s avatar`}
              width="80"
              height="80"
              class="friend-avatar w-16 h-16 md:w-20 md:h-20 rd-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </a>
          <a
            href={friend.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 md:mt-3 text-xs md:text-sm font-medium opacity-85 hover:opacity-100 transition-opacity decoration-none"
          >
            {friend.name}
          </a>
          {friend.tooltip && (
            <span class="mt-1 text-2xs md:text-xs opacity-40 text-center leading-snug px-1">{friend.tooltip}</span>
          )}
          <div class="mt-2 flex gap-2 md:gap-3 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300">
            <a
              href={friend.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs opacity-45 hover:opacity-100 transition-opacity decoration-none"
            >
              <i class="i-simple-icons-github text-xs md:text-sm" />
              <span class="md:hidden">GitHub</span>
            </a>
            <a
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs opacity-45 hover:opacity-100 transition-opacity decoration-none"
            >
              <i class="i-ri-global-line text-xs md:text-sm" />
              <span class="md:hidden">Web</span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .friend-avatar {
    filter: blur(10px);
    transform: scale(1.05);
  }

  .friend-avatar.loaded {
    filter: blur(0);
    transform: scale(1);
  }
</style>

<script>
  function initBlurLoad() {
    document.querySelectorAll('.friend-avatar').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) {
        return
      }
      const handleLoad = () => img.classList.add('loaded')
      img.complete ? handleLoad() : img.addEventListener('load', handleLoad, { once: true })
    })
  }

  initBlurLoad()
  document.addEventListener('astro:page-load', initBlurLoad)
</script>
