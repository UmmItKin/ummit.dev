---
import PostListPage from '@/components/PostListPage.astro'
import { getPosts } from '@/utils/posts'

const posts = await getPosts(undefined, 'ctf')
---

<PostListPage
  title="CTF Writeups"
  description="List of all CTF writeups."
  ogImage={{ src: '/og/ctf.png', alt: 'CTF Writeups' }}
  posts={posts}
  noun={['writeup', 'writeups']}
  verb="published"
  color="text-green-400"
/>
