---
import { encryptPost } from '@/utils/post-crypto'

interface Props {
  password: string
}

const payload = await encryptPost(await Astro.slots.render('default'), Astro.props.password)
---

<div data-password-post data-payload={payload}>
  <form class="not-prose password-form" data-password-form>
    <div class="password-heading">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <rect x="5" y="10" width="14" height="11" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
      </svg>
      <p>This post is locked.</p>
    </div>
    <p class="password-description">Enter the password to read it.</p>
    <div class="password-controls">
      <label class="password-label">
        <span class="sr-only">Password</span>
        <input
          type="password"
          required
          autocomplete="current-password"
          placeholder="Password"
          aria-describedby="post-unlock-status"
        />
      </label>
      <button type="submit">Unlock</button>
    </div>
    <p id="post-unlock-status" role="status" aria-live="polite" class="password-status"></p>
    <noscript>
      <p class="mt-3">Enable JavaScript to unlock this post.</p>
    </noscript>
  </form>
  <div data-unlocked-content tabindex="-1"></div>
</div>

<style>
  .password-form {
    margin-block: 2rem;
    padding-block: 2rem 1rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    animation: password-reveal 450ms ease both;
  }
  .password-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #e5e5e5;
  }
  .password-heading p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .password-heading svg {
    color: #a3a3a3;
  }
  .password-description {
    margin: 0.6rem 0 1.25rem;
    font-size: 0.9rem;
    color: #a3a3a3;
  }
  .password-controls {
    display: flex;
    gap: 0.65rem;
    max-width: 28rem;
  }
  .password-label {
    flex: 1;
    min-width: 0;
  }
  input,
  button {
    box-sizing: border-box;
    height: 2.875rem;
    border: 1px solid #525252;
    border-radius: 0.5rem;
    font: inherit;
    transition:
      border-color 150ms,
      background-color 150ms,
      transform 150ms;
  }
  input {
    width: 100%;
    padding: 0 0.85rem;
    background: rgb(255 255 255 / 3%);
    color: #e5e5e5;
    font-size: 1rem;
  }
  input::placeholder {
    color: #858585;
  }
  input:focus-visible,
  button:focus-visible {
    outline: 2px solid #a78bfa;
    outline-offset: 3px;
  }
  input[aria-invalid='true'] {
    border-color: #f87171;
  }
  button {
    padding: 0 1.1rem;
    background: #e5e5e5;
    color: #171717;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  button:hover {
    background: #fff;
  }
  button:active:not(:disabled) {
    transform: translateY(1px);
  }
  button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .password-status {
    min-height: 1.5em;
    max-width: 28rem;
    margin: 0.75rem 0 0;
    color: #a3a3a3;
    font-size: 0.85rem;
  }
  [data-unlocked-content].is-unlocked {
    animation: password-reveal 500ms ease both;
  }
  @keyframes password-reveal {
    from {
      opacity: 0;
      filter: blur(5px);
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .password-form,
    [data-unlocked-content].is-unlocked {
      animation: none;
    }
    input,
    button {
      transition: none;
    }
    button:active:not(:disabled) {
      transform: none;
    }
  }
</style>

<script>
  import { initPasswordPosts } from '@/utils/password-post'

  initPasswordPosts()
  document.addEventListener('astro:page-load', initPasswordPosts)
</script>
