---
import { views } from '@/config/views'

interface Props {
  slug: string
}

const { slug } = Astro.props
// Firestore document ids cannot contain '/', so flatten nested post ids.
const docId = slug.replace(/\//g, '_')
const dbRoot = `projects/${views.projectId}/databases/(default)`
const docPath = `${dbRoot}/documents/likes/${docId}`
const api = 'https://firestore.googleapis.com/v1'
---

{
  views.enabled && (
    <button
      type="button"
      class="like-button inline-flex items-center gap-2 text-sm px-3 py-2 rd-1 hover:bg-neutral-500/10 transition-all duration-200 cursor-pointer bg-transparent border-0 text-inherit"
      data-doc-path={docPath}
      data-doc-url={`${api}/${docPath}`}
      data-commit-url={`${api}/${dbRoot}/documents:commit`}
      aria-label="Like this post"
    >
      <i class="like-icon i-ri-heart-line" />
      <span class="like-count tabular-nums" />
    </button>
  )
}

<div class="like-toast" popover="manual" role="status">
  <i class="i-ri-heart-fill text-red-400"></i>
  <span class="like-toast-text"></span>
</div>

<style>
  .like-toast {
    position: fixed;
    inset: auto 0 2rem 0;
    margin: 0 auto;
    width: fit-content;
    max-width: calc(100vw - 2rem);
    padding: 0.6rem 1rem;
    border: 1px solid rgba(115, 115, 115, 0.28);
    border-radius: 0.6rem;
    background: rgba(22, 27, 34, 0.9);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #bbb;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    overflow: visible;
  }

  .like-toast:popover-open {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .like-toast {
      transition: none;
    }
  }

  /* Dim only until liked. Opacity on top of red would mute it to a dull grey. */
  .like-button {
    opacity: 0.6;
  }

  .like-button:hover {
    opacity: 1;
  }

  .like-button.is-active {
    opacity: 1;
    color: #f87171;
  }

  /* Pop the heart on like, but never on the initial render. */
  .like-button.is-liked .like-icon {
    animation: like-pop 0.28s cubic-bezier(0.2, 0, 0, 1);
  }

  @keyframes like-pop {
    50% {
      transform: scale(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .like-button.is-liked .like-icon {
      animation: none;
    }
  }
</style>

<script>
  import { addLike, hasLiked, readLikes } from '@/utils/likes'

  let hideTimer = 0

  function toast(message: string) {
    const el = document.querySelector('.like-toast')
    const text = el?.querySelector('.like-toast-text')
    if (!(el instanceof HTMLElement) || !text) {
      return
    }
    text.textContent = message
    clearTimeout(hideTimer)
    // showPopover throws if it is already open, so close first.
    el.hidePopover()
    el.showPopover()
    hideTimer = window.setTimeout(() => el.hidePopover(), 2400)
  }

  function paint(el: HTMLElement, count: number | null, liked: boolean, animate: boolean) {
    const icon = el.querySelector('.like-icon')
    const out = el.querySelector('.like-count')
    if (!icon || !out) {
      return
    }
    icon.classList.toggle('i-ri-heart-fill', liked)
    icon.classList.toggle('i-ri-heart-line', !liked)
    el.classList.toggle('is-active', liked)
    // The animation class is what triggers the pop, so only add it on a click.
    if (animate) {
      el.classList.add('is-liked')
    }
    out.textContent = count === null ? '' : String(count)
  }

  function initLikeButton() {
    document.querySelectorAll('.like-button').forEach((el) => {
      if (!(el instanceof HTMLElement) || el.dataset.bound) {
        return
      }
      el.dataset.bound = '1'

      const { docPath, docUrl, commitUrl } = el.dataset
      if (!docPath || !docUrl || !commitUrl) {
        return
      }

      let liked = hasLiked(docPath)
      readLikes(docUrl).then((n) => paint(el, n, liked, false))

      let busy = false
      el.addEventListener('click', async () => {
        if (busy) {
          return
        }
        // Likes cannot be taken back, so say so instead of doing nothing.
        if (liked) {
          toast('You already liked this post')
          return
        }

        busy = true
        el.classList.remove('is-liked')
        const count = await addLike(commitUrl, docPath)
        if (count !== null) {
          liked = true
          paint(el, count, true, true)
          toast('Thanks for the like')
        }
        if (count === null) {
          toast('Could not save your like, try again')
        }
        busy = false
      })
    })
  }
  initLikeButton()
  document.addEventListener('astro:page-load', initLikeButton)
</script>
