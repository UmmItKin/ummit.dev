---
import { sponsor } from '@/config/sponsor'
---

<div class="sponsor-wrap">
  <p class="sponsor-text">
    <i class="i-ri-heart-fill"></i>
    {sponsor.text}{sponsor.subtitle && ` \u2014 ${sponsor.subtitle}`}
  </p>
  <div class="sponsor-buttons">
    {
      sponsor.links.map((link: any) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="sponsor-button"
          style={link.hoverColor ? `--hover-color: ${link.hoverColor}` : ''}
          aria-label={`${link.platform}`}
        >
          <i class={link.icon} />
          <span>{link.platform}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .sponsor-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sponsor-text {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sponsor-text i {
    color: #f472b6;
  }

  .sponsor-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .sponsor-buttons {
      flex-direction: row;
    }
  }

  .sponsor-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #d4d4d4;
    background: rgba(163, 163, 163, 0.08);
    border: 1px solid rgba(163, 163, 163, 0.25);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .sponsor-button i {
    font-size: 1.1rem;
  }

  .sponsor-button:hover {
    background: color-mix(in srgb, var(--hover-color, #888) 12%, transparent);
    border-color: color-mix(in srgb, var(--hover-color, #888) 45%, transparent);
    color: var(--hover-color, #d4d4d4);
  }
</style>
