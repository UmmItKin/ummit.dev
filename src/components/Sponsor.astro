---
interface Props {
  text?: string
}

const { text = 'Sponsor to support UmmIt' } = Astro.props
---

<div class="flex flex-col sm:flex-row gap-3">
  <a href="https://github.com/sponsors/UmmItKin" target="_blank" rel="noopener noreferrer" class="sponsor-button">
    <i class="i-ri-heart-fill"></i>
    <span>{text}</span>
  </a>
</div>

<style>
  .sponsor-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: #a3a3a3;
    background: rgba(163, 163, 163, 0.1);
    border: 1px solid rgba(163, 163, 163, 0.3);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .sponsor-button:hover {
    background: rgba(236, 72, 153, 0.15);
    border-color: rgba(236, 72, 153, 0.5);
    color: #f472b6;
  }

  .sponsor-button i {
    font-size: 1.25rem;
  }
</style>
