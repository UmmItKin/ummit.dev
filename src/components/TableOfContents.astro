---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

// Keep h2 + h3 only; skip post title (h1) and noisy deeper levels.
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 3)

const shouldRender = toc.some((h) => h.depth === 2)

// Per-depth horizontal line offset inside the SVG (matches Fumadocs values).
function lineOffset(depth: number): number {
  if (depth <= 2) return 8
  if (depth === 3) return 16
  return 24
}
function itemOffset(depth: number): number {
  // Padding from container left edge to the link text.
  if (depth <= 2) return 20
  if (depth === 3) return 32
  return 44
}
---

{
  shouldRender && (
    <>
      <details class="toc-mobile not-prose mb-8 xl:hidden border-1 border-main rounded-md bg-neutral-500/5">
        <summary class="cursor-pointer py-2 px-3 text-sm op-70 hover:op-100 transition-opacity duration-200 select-none">
          <span class="i-ri-list-unordered align-middle mr-1.5" />
          Table of contents
        </summary>
        <nav class="px-3 pb-3 pt-1 max-h-[60vh] overflow-y-auto" aria-label="Table of contents">
          <ul class="toc-mobile-list" style="list-style: none; padding: 0; margin: 0;">
            {toc.map((h) => (
              <li style={`list-style: none; padding-left: ${(h.depth - 2) * 1}rem;`}>
                <a
                  href={`#${h.slug}`}
                  class={`toc-link block py-0.5 leading-snug decoration-none transition-colors duration-200 ${
                    h.depth === 2 ? 'text-sm op-80 hover:op-100' : 'text-xs op-55 hover:op-90'
                  }`}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>

      <aside
        class="toc-desktop not-prose hidden xl:block fixed top-24 w-60 max-h-[calc(100vh-12rem)] overflow-y-auto z-10"
        style="left: calc(50% + 24rem + 2rem);"
        aria-label="Table of contents"
      >
        <p class="text-xs op-50 uppercase tracking-wider mb-3 font-mono flex items-center gap-1.5">
          <span class="i-ri-menu-line text-base" />
          On this page
        </p>
        <div class="toc-container relative flex flex-col">
          <div class="toc-thumb-wrap absolute top-0 left-0 pointer-events-none" aria-hidden="true" />

          {toc.map((h, i) => {
            const prev = toc[i - 1]
            const l1 = lineOffset(h.depth)
            const l0 = i === 0 ? l1 : lineOffset(prev.depth)
            const drawCurve = l0 !== l1
            return (
              <a
                href={`#${h.slug}`}
                data-toc-slug={h.slug}
                data-toc-depth={h.depth}
                data-toc-l0={l0}
                data-toc-l1={l1}
                class="toc-link relative py-1.5 text-sm leading-snug op-50 hover:op-90 transition-colors duration-200 decoration-none wrap-anywhere"
                style={`padding-left: ${itemOffset(h.depth)}px;`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="toc-rail absolute -top-1.5 left-0 bottom-0 h-[calc(100%+0.375rem)] -z-1 pointer-events-none"
                  style={`width: ${Math.max(l0, l1) + 9}px;`}
                >
                  {drawCurve && (
                    <path
                      d={`M ${l0 + 0.5} 0 C ${l0 + 0.5} 8 ${l1 + 0.5} 4 ${l1 + 0.5} 12`}
                      stroke-width="1"
                      fill="none"
                      class="toc-rail-stroke"
                    />
                  )}
                  <line
                    x1={l1 + 0.5}
                    y1={drawCurve ? 12 : 6}
                    x2={l1 + 0.5}
                    y2="100%"
                    stroke-width="1"
                    class="toc-rail-stroke"
                  />
                </svg>
                {h.text}
              </a>
            )
          })}
        </div>
      </aside>
    </>
  )
}
<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  /* Mobile TOC: kill prose bullets / margins. */
  .toc-mobile ul,
  .toc-mobile li {
    list-style: none !important;
    margin: 0 !important;
  }
  .toc-mobile li::marker,
  .toc-mobile li::before {
    content: none !important;
    display: none !important;
  }
  .toc-mobile a.toc-link.toc-active {
    opacity: 1;
    color: var(--toc-line-active);
  }

  /* ===== Desktop TOC: dim rail + active SVG thumb ===== */
  :root {
    --toc-line: rgba(255, 255, 255, 0.18);
    --toc-line-active: #a371f7;
  }
  aside.toc-desktop {
    --toc-line: rgba(255, 255, 255, 0.18);
    --toc-line-active: #a371f7;
  }
  aside.toc-desktop .toc-rail-stroke {
    stroke: var(--toc-line);
    stroke-width: 1.25;
  }
  aside.toc-desktop .toc-thumb-stroke {
    stroke: var(--toc-line-active);
    stroke-width: 1.5;
  }

  aside.toc-desktop a.toc-link {
    color: inherit;
  }
  aside.toc-desktop a.toc-link.toc-active {
    opacity: 1;
    color: var(--toc-line-active);
  }
</style>
<script>
  function initTOC() {
    const links = document.querySelectorAll('a.toc-link')
    if (!links.length) {
      return
    }

    // slug -> all matching link nodes (mobile + desktop).
    const linkMap = new Map()
    links.forEach((link) => {
      const slug = link.getAttribute('href')?.slice(1)
      if (!slug) {
        return
      }
      if (!linkMap.has(slug)) {
        linkMap.set(slug, [])
      }
      linkMap.get(slug).push(link)
    })

    // Heading elements in document order.
    const headingEls = []
    linkMap.forEach((_, slug) => {
      const el = document.getElementById(slug)
      if (el) {
        headingEls.push(el)
      }
    })
    if (!headingEls.length) {
      return
    }

    // Desktop-only thumb overlay setup.
    const container = document.querySelector('.toc-desktop .toc-container')
    const thumbWrap = document.querySelector('.toc-desktop .toc-thumb-wrap')
    const desktopLinks = container ? Array.from(container.querySelectorAll('a.toc-link[data-toc-slug]')) : []

    let geo = []
    let pathD = ''
    let svgWidth = 0
    let svgHeight = 0
    let activeSlug = headingEls[0]?.id ?? null

    function buildThumbPath() {
      if (!container || !thumbWrap || !desktopLinks.length) {
        return
      }
      geo = []
      pathD = ''
      svgWidth = 0
      svgHeight = 0

      desktopLinks.forEach((link, i) => {
        const slug = link.dataset.tocSlug
        const l0 = Number.parseFloat(link.dataset.tocL0 || '8')
        const l1 = Number.parseFloat(link.dataset.tocL1 || '8')
        const styles = getComputedStyle(link)
        const top = link.offsetTop + Number.parseFloat(styles.paddingTop)
        const bottom = link.offsetTop + link.clientHeight - Number.parseFloat(styles.paddingBottom)
        const x = l1 + 0.5

        svgWidth = Math.max(svgWidth, Math.max(l0, l1) + 9)
        svgHeight = Math.max(svgHeight, bottom)

        if (i === 0) {
          pathD += `M${x} ${top} L${x} ${bottom}`
        }
        if (i > 0) {
          const prev = geo[i - 1]
          pathD += ` C ${prev.x} ${top - 4} ${x} ${prev.bottom + 4} ${x} ${top} L${x} ${bottom}`
        }
        geo.push({ slug, top, bottom, x })
      })

      // Render the overlay SVG once.
      thumbWrap.style.width = `${svgWidth}px`
      thumbWrap.style.height = `${svgHeight}px`
      thumbWrap.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${svgWidth} ${svgHeight}"
             width="${svgWidth}" height="${svgHeight}"
             class="toc-thumb-svg absolute inset-0"
             style="clip-path: polygon(0 var(--track-top,0px), 100% var(--track-top,0px), 100% var(--track-bottom,0px), 0 var(--track-bottom,0px)); transition: clip-path 0.25s ease;">
          <path d="${pathD}" stroke-width="1" fill="none" class="toc-thumb-stroke" />
        </svg>
      `
    }

    function setThumb(slug) {
      if (!thumbWrap) {
        return
      }
      const svg = thumbWrap.querySelector('.toc-thumb-svg')
      if (!svg) {
        return
      }
      if (!slug) {
        svg.style.setProperty('--track-top', '0px')
        svg.style.setProperty('--track-bottom', '0px')
        return
      }
      const item = geo.find((g) => g.slug === slug)
      if (!item) {
        return
      }
      svg.style.setProperty('--track-top', `${item.top}px`)
      svg.style.setProperty('--track-bottom', `${item.bottom}px`)
    }

    function setActive(slug) {
      linkMap.forEach((nodes, s) => {
        const active = s === slug
        nodes.forEach((n) => n.classList.toggle('toc-active', active))
      })
      setThumb(slug)
    }

    buildThumbPath()
    if (container) {
      const ro = new ResizeObserver(() => {
        buildThumbPath()
        setThumb(activeSlug)
      })
      ro.observe(container)
      window.__tocCleanupRO?.()
      window.__tocCleanupRO = () => ro.disconnect()
    }

    if (activeSlug) {
      setActive(activeSlug)
    }
    const visible = new Set()

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id
          if (entry.isIntersecting) {
            visible.add(id)
          }
          if (!entry.isIntersecting) {
            visible.delete(id)
          }
        })
        const firstVisible = headingEls.find((h) => visible.has(h.id))
        if (firstVisible && firstVisible.id !== activeSlug) {
          activeSlug = firstVisible.id
          setActive(activeSlug)
        }
      },
      {
        rootMargin: '-80px 0px -70% 0px',
        threshold: 0,
      },
    )
    headingEls.forEach((h) => observer.observe(h))

    window.__tocCleanup?.()
    window.__tocCleanup = () => observer.disconnect()
  }

  document.addEventListener('astro:page-load', initTOC)
  if (document.readyState !== 'loading') {
    initTOC()
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTOC)
  }
</script>
