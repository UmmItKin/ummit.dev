---
import type { CollectionPosts } from '@/types'
import { views as viewsConfig } from '@/config/views'
import { batchRefs } from '@/utils/views'

interface Props {
  list: CollectionPosts[]
}

const { list = [] } = Astro.props

const { dbRoot, batchUrl } = batchRefs
// Firestore document ids cannot contain '/', so flatten nested post ids.
const statIds = list.map((post) => post.id.replace(/\//g, '_'))

function getDate(date: string) {
  return new Date(date).toISOString()
}

function getHref(post: CollectionPosts) {
  if (post.data.redirect) {
    return post.data.redirect
  }
  const basePath = post.collection === 'blog' ? '/posts' : `/${post.collection}`
  return `${basePath}/${post.id}`
}

function getTarget(post: CollectionPosts) {
  if (post.data.redirect) {
    return '_blank'
  }
  return '_self'
}

function isSameYear(a: Date | string | number, b: Date | string | number) {
  return a && b && getYear(a) === getYear(b)
}

function getYear(date: Date | string | number) {
  return new Date(date).getFullYear()
}
---

<ul class="sm:min-h-38 min-h-28 mb-18">
  {
    !list || list.length === 0 ? (
      <div class="my-12 opacity-50">nothing here yet.</div>
    ) : (
      list.map((post, index) => (
        <li class="mb-8">
          {!isSameYear(post.data.date, list[index - 1]?.data.date) && (
            <div class="select-none relative h-18 pointer-events-none">
              <span class="text-7em color-transparent font-bold text-stroke-2 text-stroke-hex-aaa op-14 absolute top--0.2em">
                {getYear(post.data.date)}
              </span>
            </div>
          )}
          <a
            class="text-lg lh-tight nav-link flex flex-col gap-2 group"
            aria-label={post.data.title}
            target={getTarget(post)}
            href={getHref(post)}
          >
            <div class="flex gap-2 items-center text-wrap">
              <span class="lh-normal">
                {post.data.draft && <i class="text-base vertical-mid i-ri-draft-line" />}
                {post.data.title}
              </span>
            </div>
            <div class="opacity-50 text-sm flex gap-2 items-center flex-wrap">
              {post.data.redirect && <i class="text-base i-ri-external-link-line" />}
              {post.data.video && <i class="text-base i-ri:film-line" />}
              {post.data.date && (
                <time datetime={getDate(post.data.date)} class="ws-nowrap">
                  {post.data.date.split(',')[0]}
                </time>
              )}
              {post.data.lastmod && <span class="ws-nowrap">· Updated: {post.data.lastmod.split(',')[0]}</span>}
              {post.data.duration && <span class="ws-nowrap">· {post.data.duration}</span>}
              {post.data.tag && <span>· {post.data.tag}</span>}
              {post.data.lang?.includes('zh') && <span class="ws-nowrap">· 中文</span>}
              {viewsConfig.enabled && <span class="post-stats ws-nowrap" data-stat-id={post.id.replace(/\//g, '_')} />}
            </div>
            <div class="opacity-50 text-sm">{post.data.description}</div>
          </a>
        </li>
      ))
    )
  }
</ul>

<style>
  /* Counts arrive after the page renders, so ease them in instead of
     letting them pop into the middle of a settled line. */
  .post-stats {
    opacity: 0;
    filter: blur(4px);
    transition:
      opacity 0.4s ease,
      filter 0.4s ease;
  }

  .post-stats.is-loaded {
    opacity: 1;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-stats {
      transition: none;
    }
  }
</style>

{
  viewsConfig.enabled && statIds.length > 0 && (
    <div
      class="post-stats-loader hidden"
      data-batch-url={batchUrl}
      data-db-root={dbRoot}
      data-ids={statIds.join(',')}
    />
  )
}

<script>
  import { fetchStats } from '@/utils/stats'

  async function initPostStats() {
    const loader = document.querySelector('.post-stats-loader')
    if (!(loader instanceof HTMLElement) || loader.dataset.bound) {
      return
    }
    loader.dataset.bound = '1'

    const { batchUrl, dbRoot, ids } = loader.dataset
    if (!batchUrl || !dbRoot || !ids) {
      return
    }

    const stats = await fetchStats(batchUrl, dbRoot, ids.split(','))
    document.querySelectorAll('.post-stats').forEach((el) => {
      const id = el instanceof HTMLElement ? el.dataset.statId : null
      const s = id ? stats.get(id) : undefined
      // A post nobody has opened has no document, so show nothing at all
      // rather than a row of zeroes.
      if (!s || (s.views === 0 && s.likes === 0)) {
        return
      }
      const parts = []
      if (s.views > 0) {
        parts.push(`${s.views.toLocaleString()} views`)
      }
      if (s.likes > 0) {
        parts.push(`${s.likes.toLocaleString()} likes`)
      }
      el.textContent = `· ${parts.join(' · ')}`
      // Next frame, so the browser paints the blurred state before the
      // transition starts. Setting both at once would skip the animation.
      requestAnimationFrame(() => el.classList.add('is-loaded'))
    })
  }
  initPostStats()
  document.addEventListener('astro:page-load', initPostStats)
</script>
