---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { CollectionPosts, PostKey } from '@/types'
import { getPosts } from '@/utils/posts'

interface Props {
  post: CollectionPosts
}

export async function createPostPaths(collection: PostKey) {
  const posts = await getPosts(undefined, collection)
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, image, description, date, lastmod, duration, tag } = post.data
const { Content } = await post.render()

// Generate OG image path based on collection type
function getOgPath() {
  if (image?.src) return image.src
  if (post.collection === 'ctf') return `/og/ctf/${post.slug}.png`
  if (post.collection === 'talks') return `/og/talks/${post.slug}.png`
  return `/og/${post.slug}.png`
}
const ogImage = getOgPath()

function getDate(dateStr: string) {
  return new Date(dateStr).toISOString()
}

function isOutdated(dateStr: string, lastmodStr?: string) {
  const relevantDate = lastmodStr || dateStr
  const date = new Date(relevantDate)
  const now = new Date()
  const sixMonthsInMs = 180 * 24 * 60 * 60 * 1000
  return now.getTime() - date.getTime() > sixMonthsInMs
}
---

<BaseLayout title={title} description={description} image={{ src: ogImage, alt: title }} pageType="article">
  <article class="prose">
    <h1>{title}</h1>
    <p class="op-50">
      {date && <time datetime={getDate(date)}>{date}</time>}
      {lastmod && <span class="op-70"> · Updated: {lastmod}</span>}
      {duration && <span> · {duration}</span>}
      {tag && <span> · {tag}</span>}
    </p>
    {
      post.collection === 'blog' && isOutdated(date, lastmod) && (
        <p class="op-60 text-sm flex items-center gap-1 mt-2">
          <i class="i-ri-alert-line text-orange-500" />
          <span>The article may be outdated as it hasn't been updated in over six months.</span>
        </p>
      )
    }
    {
      image && (
        <p>
          <img width="640" height="360" src={image.src} alt={image.alt || ''} />
        </p>
      )
    }
    <Content />
  </article>
</BaseLayout>
