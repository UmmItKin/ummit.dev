---
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { CollectionPosts, PostKey } from '@/types'
import { getPosts } from '@/utils/posts'

interface Props {
  post: CollectionPosts
}

export async function createPostPaths(collection: PostKey) {
  const posts = await getPosts(undefined, collection)
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, image, description, date, lastmod, duration, tag } = post.data
const { Content } = await post.render()

// Generate OG image path based on collection type
function getOgPath() {
  if (image?.src) return image.src
  if (post.collection === 'ctf') return `/og/ctf/${post.slug}.png`
  if (post.collection === 'talks') return `/og/talks/${post.slug}.png`
  return `/og/${post.slug}.png`
}
const ogImage = getOgPath()

function getDate(dateStr: string) {
  return new Date(dateStr).toISOString()
}

function getOutdatedInfo(dateStr: string, lastmodStr?: string) {
  const relevantDate = lastmodStr || dateStr
  const date = new Date(relevantDate)
  const now = new Date()
  const monthsAgo = (now.getTime() - date.getTime()) / (30 * 24 * 60 * 60 * 1000)

  if (monthsAgo < 6) return null

  if (monthsAgo >= 36) {
    return {
      icon: 'i-ri-skull-line',
      color: 'text-red-600',
      message:
        'RIP! This article is ancient (3+ years old). The content is probably archaeological material now. Good luck!',
    }
  }
  if (monthsAgo >= 24) {
    return {
      icon: 'i-ri-error-warning-line',
      color: 'text-red-500',
      message: "Wowah, this article may be useless as it hasn't been updated in over 2 years. XDD",
    }
  }
  if (monthsAgo >= 12) {
    return {
      icon: 'i-ri-alert-line',
      color: 'text-orange-500',
      message: "Oops, as it hasn't been updated in 1 year, so the content you better to research again.",
    }
  }

  return {
    icon: 'i-ri-alert-line',
    color: 'text-yellow-500',
    message: "The article may be outdated as it hasn't been updated in over six months.",
  }
}
---

<BaseLayout title={title} description={description} image={{ src: ogImage, alt: title }} pageType="article">
  <article class="prose">
    <h1>{title}</h1>
    <p class="op-50">
      {date && <time datetime={getDate(date)}>{date}</time>}
      {lastmod && <span class="op-70"> · Updated: {lastmod}</span>}
      {duration && <span> · {duration}</span>}
      {tag && <span> · {tag}</span>}
    </p>
    {
      (() => {
        const outdatedInfo = post.collection === 'blog' ? getOutdatedInfo(date, lastmod) : null
        return (
          outdatedInfo && (
            <p class="op-60 text-sm flex items-center gap-1 mt-2">
              <i class:list={[outdatedInfo.icon, outdatedInfo.color]} />
              <span>{outdatedInfo.message}</span>
            </p>
          )
        )
      })()
    }
    {
      image && (
        <p>
          <img width="640" height="360" src={image.src} alt={image.alt || ''} />
        </p>
      )
    }
    <Content />
  </article>
</BaseLayout>
