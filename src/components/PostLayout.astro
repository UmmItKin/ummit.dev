---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LikeButton from '@/components/LikeButton.astro'
import ShareButton from '@/components/ShareButton.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import ViewCounter from '@/components/ViewCounter.astro'
import type { CollectionPosts, PostKey } from '@/types'
import { getPosts } from '@/utils/posts'
import { render } from 'astro:content'

interface Props {
  post: CollectionPosts
}

export async function createPostPaths(collection: PostKey) {
  const posts = await getPosts(undefined, collection)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, image, description, date, lastmod, duration, tag } = post.data
const { Content, headings } = await render(post)

// Generate OG image path based on collection type
function getOgPath() {
  if (image?.src) return image.src
  if (post.collection === 'ctf') return `/og/ctf/${post.id}.png`
  if (post.collection === 'talks') return `/og/talks/${post.id}.png`
  if (post.collection === 'research') return `/og/research/${post.id}.png`
  if (post.collection === 'paper') return `/og/paper/${post.id}.png`
  if (post.collection === 'infosec') return `/og/infosec/${post.id}.png`
  return `/og/${post.id}.png`
}
const ogImage = getOgPath()
const shareUrl = new URL(Astro.url.pathname, Astro.site).href

function getDate(dateStr: string) {
  return new Date(dateStr).toISOString()
}

function getOutdatedInfo(dateStr: string, lastmodStr?: string) {
  const relevantDate = lastmodStr || dateStr
  const date = new Date(relevantDate)
  const now = new Date()
  const monthsAgo = (now.getTime() - date.getTime()) / (30 * 24 * 60 * 60 * 1000)

  if (monthsAgo < 6) return null

  if (monthsAgo >= 36) {
    return {
      icon: 'i-ri-skull-line',
      color: 'text-red-600',
      message:
        'RIP! This article is ancient (3+ years old). The content is probably archaeological material now. Good luck!',
    }
  }
  if (monthsAgo >= 24) {
    return {
      icon: 'i-ri-error-warning-line',
      color: 'text-red-500',
      message: "Wowah, this article may be useless as it hasn't been updated in over 2 years. XDD",
    }
  }
  if (monthsAgo >= 12) {
    return {
      icon: 'i-ri-alert-line',
      color: 'text-orange-500',
      message: "Oops, as it hasn't been updated in 1 year, so the content you better to research again.",
    }
  }

  return {
    icon: 'i-ri-alert-line',
    color: 'text-yellow-500',
    message: "The article may be outdated as it hasn't been updated in over six months.",
  }
}
---

<!-- Actually javascript:history.back()" also work xdd-->
<BaseLayout title={title} description={description} image={{ src: ogImage, alt: title }} pageType="article">
  <div class="mb-6">
    <button
      onclick="history.back()"
      class="inline-flex items-center gap-2 text-sm opacity-60 hover:opacity-100 transition-opacity duration-200 cursor-pointer bg-transparent border-0 p-0"
    >
      <span class="font-mono">&gt; z ../</span>
    </button>
  </div>
  <article class="prose">
    <h1>{title}</h1>
    <p class="op-50 mb-2">
      {date && <time datetime={getDate(date)}>{date}</time>}
      {lastmod && <span class="op-70"> · Updated: {lastmod}</span>}
      {duration && <span> · {duration}</span>}
      {tag && <span> · {tag}</span>}
    </p>
    <div class="not-prose flex items-center gap-2 -ml-3 mb-6">
      <LikeButton slug={post.id} />
      <ViewCounter slug={post.id} />
    </div>
    {
      (() => {
        const outdatedInfo = post.collection === 'blog' ? getOutdatedInfo(date, lastmod) : null
        return (
          outdatedInfo && (
            <p class="op-60 text-sm flex items-center gap-1 mt-2">
              <i class:list={[outdatedInfo.icon, outdatedInfo.color]} />
              <span>{outdatedInfo.message}</span>
            </p>
          )
        )
      })()
    }
    {
      image && (
        <p>
          <img width="640" height="360" src={image.src} alt={image.alt || ''} />
        </p>
      )
    }
    <TableOfContents headings={headings} />
    <Content />
  </article>
  <div class="mt-8 pt-6 border-t border-neutral-800 -ml-3">
    <ShareButton title={title} url={shareUrl} />
  </div>
</BaseLayout>

<style is:global>
  article.prose img {
    filter: blur(10px);
    transform: scale(1.02);
    transition:
      filter 0.5s ease,
      transform 0.5s ease;
  }
  article.prose img.loaded {
    filter: blur(0);
    transform: scale(1);
  }
</style>

<script>
  function initPostBlur() {
    document.querySelectorAll('article.prose img').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) {
        return
      }
      const done = () => img.classList.add('loaded')
      if (img.complete && img.naturalWidth > 0) {
        done()
        return
      }
      img.addEventListener('load', done, { once: true })
      img.addEventListener('error', done, { once: true })
    })
  }
  initPostBlur()
  document.addEventListener('astro:page-load', initPostBlur)
</script>
