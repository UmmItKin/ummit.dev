---
import { views } from '@/config/views'
import { docRefs } from '@/utils/views'

interface Props {
  slug: string
}

const { slug } = Astro.props
// docPath is the id Firestore expects in a write, docUrl is the same document
// as a REST url. Both come from docRefs so they cannot drift apart.
const { docPath, docUrl, commitUrl } = docRefs('views', slug)
---

{
  views.enabled && (
    <span class="view-counter" data-doc-path={docPath} data-doc-url={docUrl} data-commit-url={commitUrl}>
      <span class="view-count tabular-nums" />
    </span>
  )
}

<style>
  .view-counter {
    font-weight: 600;
    font-size: 0.875rem;
    opacity: 0;
    filter: blur(4px);
    transition:
      opacity 0.4s ease,
      filter 0.4s ease;
  }

  /* Matches the like button's resting dim so the two sit level. */
  .view-counter.is-loaded {
    opacity: 0.6;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .view-counter {
      transition: none;
    }
  }
</style>

<script>
  import { fetchViews } from '@/utils/views'

  function show(el: Element, n: number) {
    el.textContent = `${n.toLocaleString()} ${n === 1 ? 'view' : 'views'}`
  }

  async function countView(el: HTMLElement) {
    const { docPath, docUrl, commitUrl } = el.dataset
    const out = el.querySelector('.view-count')
    if (!docPath || !docUrl || !commitUrl || !out) {
      return
    }
    const n = await fetchViews(commitUrl, docUrl, docPath)
    if (n !== null) {
      show(out, n)
      // Next frame, so the blurred state paints before the transition runs.
      requestAnimationFrame(() => el.classList.add('is-loaded'))
    }
  }

  function initViewCounter() {
    document.querySelectorAll('.view-counter').forEach((el) => {
      if (el instanceof HTMLElement && !el.dataset.bound) {
        el.dataset.bound = '1'
        countView(el)
      }
    })
  }
  initViewCounter()
  document.addEventListener('astro:page-load', initViewCounter)
</script>
