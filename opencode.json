{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "README.md",
    "src/site-config.ts",
    "astro.config.ts",
    "uno.config.ts",
    "tsconfig.json",
    "eslint.config.js",
    ".github/workflows/*.yml"
  ],
  "models": {
    "default": "claude-sonnet-4",
    "fast": "claude-haiku-4"
  },
  "agents": {
    "explore": {
      "description": "Specialized for exploring the Vue + Astro codebase architecture",
      "instructions": [
        "src/components/**/*.{vue,astro}",
        "src/content/config.ts",
        "src/types.ts"
      ]
    },
    "content": {
      "description": "Helps with blog post creation, CTF writeups, and content management",
      "instructions": [
        "src/content/**/*.md",
        "src/content/config.ts"
      ]
    },
    "build": {
      "description": "Handles build optimization, performance, and deployment",
      "instructions": [
        "package.json",
        ".github/workflows/*.yml",
        "bun.lock"
      ]
    }
  },
  "rules": [
    "Always use Bun over npm/yarn for package management",
    "Maintain TypeScript strict mode throughout the codebase",
    "Follow Vue 3 Composition API best practices",
    "Use UnoCSS atomic classes over custom CSS",
    "Ensure all content has proper frontmatter validation",
    "Test builds before committing changes",
    "Follow conventional commit message format",
    "Optimize images for web performance",
    "Maintain accessibility standards (WCAG AA)",
    "Use semantic HTML structure"
  ],
  "skills": [
    "vue",
    "vue-best-practices",
    "vueuse-functions",
    "unocss",
    "vite",
    "vitest",
    "antfu",
    "web-design-guidelines"
  ],
  "preferences": {
    "packageManager": "bun",
    "typescript": {
      "strict": true,
      "noImplicitAny": true,
      "exactOptionalPropertyTypes": true
    },
    "vue": {
      "version": "3",
      "compositionApi": true,
      "scriptSetup": true
    },
    "css": {
      "framework": "unocss",
      "approach": "atomic"
    }
  },
  "commands": {
    "dev": "bun dev",
    "build": "bun build",
    "lint": "bun lint",
    "lint:fix": "bun lint:fix",
    "release": "bun release"
  },
  "files": {
    "ignore": [
      "dist/**",
      "node_modules/**",
      ".astro/**",
      "*.log",
      ".eslintcache"
    ],
    "watch": [
      "src/**/*.{ts,vue,astro,md,mdx}",
      "public/**/*",
      "*.config.{ts,js}",
      "package.json"
    ]
  }
}
