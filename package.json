{
  "name": "astro-theme-vitesse",
  "type": "module",
  "version": "1.12.1",
  "description": "A minimal, SEO-friendly portfolio and blog theme for Astro, supports Vue and UnoCSS.",
  "author": "Kieran Wong <kieranwme@gmail.com> (https://github.com/kieranwv/), UmmIt Kin <hi@ummit.dev> (https://github.com/UmmItKin/)",
  "license": "MIT",
  "keywords": [
    "astro",
    "blog",
    "starter",
    "template",
    "portfolio",
    "vue",
    "unocss",
    "mdx",
    "rss",
    "UmmIt Kin"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@unocss/astro": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "astro": "^7.3.5",
    "chart.js": "^4.5.1",
    "nprogress": "^0.2.0",
    "satori": "^0.33.5",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.4",
    "unocss": "^66.10.5",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify/json": "^2.2.533",
    "@types/nprogress": "^0.2.3",
    "@vueuse/core": "^15.0.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.5.1",
    "prettier-plugin-astro": "^1.0.1",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged && bun run lint && bun run build"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue,astro,md,mdx,yml,yaml}": "eslint --fix"
  }
}
