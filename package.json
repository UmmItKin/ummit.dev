{
  "name": "astro-theme-vitesse",
  "type": "module",
  "version": "1.5.0",
  "description": "A minimal, SEO-friendly portfolio and blog theme for Astro, supports Vue and UnoCSS.",
  "author": "Kieran Wong <kieranwme@gmail.com> (https://github.com/kieranwv/), UmmIt Kin <hi@ummit.dev> (https://github.com/UmmItKin/)",
  "license": "MIT",
  "keywords": [
    "astro",
    "blog",
    "starter",
    "template",
    "portfolio",
    "vue",
    "unocss",
    "mdx",
    "rss",
    "UmmIt Kin"
  ],
  "engines": {
    "node": ">=v18.17.1 || >=v20.3.0 || >=21"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/vue": "^5.1.4",
    "@unocss/reset": "^66.6.0",
    "astro": "^5.17.2",
    "nprogress": "^0.2.0",
    "satori": "^0.19.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.34.5",
    "unocss": "^66.6.0",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@iconify/json": "^2.2.439",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "@vueuse/core": "^14.2.1",
    "bumpp": "^10.4.1",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-format": "^1.4.0",
    "lint-staged": "^16.2.7",
    "lodash-es": "^4.17.23",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint:fix"
  }
}
